# Template for /etc/cfb-poll/weekly.env on the Hostinger VPS.
#
#   sudo install -d -m 0750 -o root -g cfbpoll /etc/cfb-poll
#   sudo install -m 0640 -o root -g cfbpoll weekly.env.example /etc/cfb-poll/weekly.env
#   sudo nano /etc/cfb-poll/weekly.env      # paste the real values
#
# chmod 0640 root:cfbpoll, never 0644. This file holds the CFBD key, and a
# leaked key is the one catastrophic mistake available to this project.
#
# NOTHING HERE IS REQUIRED. With no CFBD key the job runs the MIT
# SportsDataverse leg and produces a real ranking from fewer games; with no
# DATABASE_URL the Postgres load skips and the files remain the source of truth.
# That degradation is the same one a fork gets, which is how we know it works.

# The CFBD bearer token. Needed for exactly two things: resolving the live week
# from /calendar, and pulling the week's raw results into archive/cfbd/.
CFBD_API_KEY=

# Optional. The serving-table cache. Absent, `publish postgres` says so and exits 0.
# DATABASE_URL=

# Where the published JSON tree lives on this machine. This must be the tree the
# website actually reads, or the poll will publish into a directory nobody serves.
FIXTURES=/srv/cfb-poll-data

# Public base URL of that tree, so the guard can ask "is this week already up?"
# over HTTPS instead of trusting one machine's disk. Leave blank to skip.
PUBLISHED_URL=https://thepoll.ai/data

# Set to false for a rehearsal that fits and writes out/ but publishes nothing.
PUBLISH=true
